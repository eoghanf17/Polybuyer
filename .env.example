# Copy to .env and fill in.  .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# X API -- app-only auth.  The Bearer Token, NOT the OAuth 1.0a access
# token/secret: this system only reads public posts, it never acts as a user.
# console.x.com -> your app -> Keys & Tokens -> Bearer Token -> Generate.
X_BEARER_TOKEN=

# OpenAI -- for the tweet gate.  platform.openai.com -> API Keys ->
# Create new secret key.  The value is shown once and never again; if you
# lose it, make a new key rather than hunting for the old one.
OPENAI_API_KEY=
OPENAI_GATE_MODEL=gpt-4.1

# Where the market database lives.
NEWSDESK_DB=newsdesk.db

# Safety rails for live trading.  Paper mode logs intended orders and places
# nothing; leave it on until the fire log looks right.
NEWSDESK_PAPER=1
NEWSDESK_MAX_DAILY_USD=100
